  "keyFeatures": [
    "Envelope budgeting methodology for zero-based budgeting",
    "Local-first architecture — all data stored on your device",
    "Multi-device sync via self-hosted or cloud sync server",
    "Bank sync via GoCardless, SimpleFin, and Pluggy.ai",
    "Powerful transaction rules and auto-categorization",
    "Scheduled recurring transactions",
    "Interactive reports: Net Worth, Cash Flow, and custom dashboards",
    "End-to-end encryption for synced budgets",
    "Programmatic access via @actual-app/api Node.js package",
    "CLI tool (@actual-app/cli) for scripting and automation",
    "Self-hosted sync server deployable via Docker or Fly.io",
    "Desktop apps for Windows, Mac, and Linux"
  ],
  "publicApiSurface": [
    "loadBudget(budgetId)",
